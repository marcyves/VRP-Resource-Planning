<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="DB_DATABASE" value="testing"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="E_INVOICE_PLATFORM" value=""/>
        <env name="E_INVOICE_ALLOW_PRODUCTION" value="false"/>
        <env name="SUPERPDP_ENV" value="sandbox"/>
        <env name="SUPERPDP_CLIENT_ID" value=""/>
        <env name="SUPERPDP_CLIENT_SECRET" value=""/>
        <env name="SUPERPDP_SANDBOX_CLIENT_ID" value=""/>
        <env name="SUPERPDP_SANDBOX_CLIENT_SECRET" value=""/>
        <env name="SUPERPDP_ACCESS_TOKEN" value=""/>
        <env name="SUPERPDP_WEBHOOK_SECRET" value=""/>
        <env name="E_INVOICE_ALERT_EMAIL" value=""/>
        <env name="E_INVOICE_REQUIRE_HTTPS_WEBHOOKS" value="false"/>
    </php>
</phpunit>
