APP_NAME="VRP Plan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=fr

# Default business context when no company is loaded (education | consulting | medical)
TERMINOLOGY_PROFILE=consulting

# Public self-registration (/register). Off by default — use super admin to provision tenants.
VRP_ALLOW_REGISTRATION=false

# Inbox for account opening requests (/demande-acces). Defaults to MAIL_FROM_ADDRESS.
VRP_ACCOUNT_REQUEST_EMAIL=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vrp_demo
DB_USERNAME=vrp_user
DB_PASSWORD=vrp_pass

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Facturation électronique (SuperPDP) — pas en production par défaut
# Laisser E_INVOICE_PLATFORM commenté sur les locataires live.
# E_INVOICE_PLATFORM=superpdp
# E_INVOICE_ALLOW_PRODUCTION=false
# sandbox (défaut) :
# SUPERPDP_ENV=sandbox
# SUPERPDP_SANDBOX_CLIENT_ID=
# SUPERPDP_SANDBOX_CLIENT_SECRET=
# production (ne pas activer sans ordre explicite + E_INVOICE_ALLOW_PRODUCTION=true) :
# SUPERPDP_ENV=production
# SUPERPDP_CLIENT_ID=
# SUPERPDP_CLIENT_SECRET=
# SUPERPDP_BASE_URL=https://api.superpdp.tech
# optionnel : jeton bearer (sans OAuth)
# SUPERPDP_ACCESS_TOKEN=
# Secret HMAC webhooks : préférer Super-admin → Facturation électronique.
# SUPERPDP_WEBHOOK_SECRET= reste un repli si aucun secret n’est enregistré dans l’UI.
# URL publique à coller dans SuperPDP (sinon APP_URL + /webhooks/e-invoice/superpdp)
# E_INVOICE_WEBHOOK_URL=https://vrp.xdm-consulting.fr/webhooks/e-invoice/superpdp
# E_INVOICE_REQUIRE_HTTPS_WEBHOOKS=false
# TRUSTED_PROXIES=*
# E_INVOICE_ALERT_EMAIL=

# Statistiques de connexion (admin) — géolocalisation sans clé payante.
# Fichier MaxMind GeoLite2-City (optionnel, ~60 Mo, ne pas committer) :
# LOGIN_STATS_GEO_MMDB=/chemin/vers/GeoLite2-City.mmdb
# Repli HTTP sans clé (ipwho.is) si le MMDB est absent. Désactiver si besoin :
# LOGIN_STATS_GEO_HTTP=true
# LOGIN_STATS_GEO_HTTP_URL=https://ipwho.is/{ip}
# LOGIN_STATS_GEO_HTTP_TIMEOUT=1.5
